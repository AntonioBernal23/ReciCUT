# --- Config Server ---
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_URL=http://config-server:8888

# --- Discovery Server (Eureka) ---
EUREKA_SERVER_PORT=8761
EUREKA_HOSTNAME=discovery-server
EUREKA_URL=http://discovery-server:8761/eureka/

# --- Auth Service ---
AUTH_SERVICE_PORT=8070

# --- MySQL (auth) ---
MYSQL_AUTH_PORT=3307
MYSQL_AUTH_HOST=mysql-auth
MYSQL_AUTH_DATABASE=auth_service
MYSQL_AUTH_ROOT_PASSWORD=
MYSQL_AUTH_USERNAME=
MYSQL_AUTH_PASSWORD=

# --- User Service ---
USER_SERVICE_PORT=8060

# --- MySQL (user) ---
MYSQL_USER_PORT=3308
MYSQL_USER_HOST=mysql-user
MYSQL_USER_DATABASE=user_service
MYSQL_USER_ROOT_PASSWORD=
MYSQL_USER_USERNAME=
MYSQL_USER_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- API-GATEWAY ---
API_GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Google ---
GOOGLE_CLIENT_ID=

# --- Kafka ---
# Dentro de Docker: kafka:19092 | Desde máquina (fuera de Docker): localhost:9092
KAFKA_BROKER=kafka:19092
# --- Report Service ---
REPORT_SERVICE_PORT=
MYSQL_REPORT_HOST=
MYSQL_REPORT_DATABASE=
MYSQL_REPORT_USERNAME=
MYSQL_REPORT_PASSWORD=

# --- Collection Service ---
COLLECTION_SERVICE_PORT=
MYSQL_COLLECTION_HOST=
MYSQL_COLLECTION_DATABASE=
MYSQL_COLLECTION_USERNAME=
MYSQL_COLLECTION_PASSWORD=
