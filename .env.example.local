# --- Config Server ---
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_URL=http://localhost:8888

# --- Discovery Server (Eureka) ---
EUREKA_SERVER_PORT=8761
EUREKA_HOSTNAME=localhost
EUREKA_URL=http://localhost:8761/eureka/

# --- Auth Service ---
AUTH_SERVICE_PORT=8070

# --- MySQL (auth) ---
MYSQL_AUTH_HOST=localhost
MYSQL_AUTH_DATABASE=auth_service
MYSQL_AUTH_USERNAME=
MYSQL_AUTH_PASSWORD=

# --- User Service ---
USER_SERVICE_PORT=8060

# --- MySQL (user) ---
MYSQL_USER_HOST=localhost
MYSQL_USER_DATABASE=user_service
MYSQL_USER_USERNAME=
MYSQL_USER_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- API-GATEWAY ---
API_GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Google ---
GOOGLE_CLIENT_ID=

# --- Kafka ---
KAFKA_BROKER=localhost:9092